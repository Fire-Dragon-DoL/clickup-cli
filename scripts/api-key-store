#!/bin/bash
set -e

read_masked() {
  local token=""
  local char=""
  while IFS= read -r -s -n1 char; do
    if [[ -z "$char" ]]; then
      break
    elif [[ "$char" == $'\x7f' || "$char" == $'\b' ]]; then
      if [[ -n "$token" ]]; then
        token="${token%?}"
        printf '\b \b' >&2
      fi
    else
      token+="$char"
      printf '*' >&2
    fi
  done
  printf '\n' >&2
  printf '%s' "$token"
}

read_from_prompt() {
  printf 'Enter your ClickUp API key: ' >&2
  read_masked
}

read_from_chezmoi() {
  chezmoi data --format json | jq -r '.secrets.clickup.key'
}

mode="${1:---prompt}"

case "$mode" in
  --prompt)
    api_key=$(read_from_prompt)
    ;;
  --chezmoi)
    api_key=$(read_from_chezmoi)
    ;;
  *)
    echo "Usage: $(basename "$0") [--prompt|--chezmoi]" >&2
    exit 1
    ;;
esac

if [[ -z "$api_key" || "$api_key" == "null" ]]; then
  echo "Error: no API key provided." >&2
  exit 1
fi

case "$(uname -s)" in
  Linux)
    # Delete existing entry if present, then store new one
    secret-tool clear service clickup-cli username api_key 2>/dev/null || true
    printf '%s' "$api_key" | secret-tool store --label='ClickUp CLI API Key' service clickup-cli username api_key
    ;;
  Darwin)
    security add-generic-password -U -s "clickup-cli" -a "api_key" -w "$api_key"
    ;;
  *)
    echo "Error: unsupported OS." >&2
    exit 1
    ;;
esac

echo "API key stored in system keyring." >&2
